config {
  type: "table",
  schema: "silver",
  description: "Integrated sales dataset combining orders, customers, and products."
}

SELECT
  o.order_id,
  o.order_date,

  o.customer_id,
  c.customer_name,
  c.state AS customer_state,
  c.signup_date,

  o.product_id,
  p.product_name,
  p.category,
  p.unit_price,

  o.quantity,

  o.quantity * p.unit_price AS total_sales,

  o.status,
  o.payment_method

FROM ${ref("orders")} AS o

LEFT JOIN ${ref("customers")} AS c
  ON o.customer_id = c.customer_id

LEFT JOIN ${ref("products")} AS p
  ON o.product_id = p.product_id